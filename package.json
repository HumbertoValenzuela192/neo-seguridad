{
  "name": "neo-seguridad",
  "version": "2.1.0",
  "private": true,
  "description": "Web comercial pública de Tigrr Security",
  "scripts": {
    "format": "prettier --write src scripts vite.config.mts tsconfig.json index.html tigrr.html",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender.tsx",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.js",
    "test": "node --test public-server.test.js && tsx --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "lucide-react": "^1.52.0",
    "ogl": "^1.0.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
