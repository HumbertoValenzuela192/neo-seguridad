DATABASE_URL=postgres://portal:portal@localhost:55432/portal
PORT=3000
PORTAL_PUBLIC_URL=http://localhost:3000
# In production, defaults to https://administrativo.tigrrsecurity.cl.
# Set a separate local host plus a compiled dist/ to test domain isolation.
PORTAL_ADMIN_URL=
# Explicit aliases, comma-separated. Use only domains you control.
PORTAL_ALLOWED_ORIGINS=
# Only used to bootstrap an empty user store; existing accounts are preserved.
PORTAL_BOOTSTRAP_PASSWORD=
# Optional; leave both empty until browser recovery and Core setup are complete.
CORE_URL=http://localhost:8080
CORE_CLIENT_DIRECTORY_TOKEN=
